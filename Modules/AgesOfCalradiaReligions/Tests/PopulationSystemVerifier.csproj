    <Compile Include="..\PopulationMath.cs"><Link>PopulationMath.cs</Link></Compile>
    <Compile Include="..\PopulationPersistence.cs"><Link>PopulationPersistence.cs</Link></Compile>
    <Compile Include="..\ReligionCatalog.cs"><Link>ReligionCatalog.cs</Link></Compile>
    <Compile Include="..\ReligionModels.cs"><Link>ReligionModels.cs</Link></Compile>
    <Compile Include="..\ReligionPersistence.cs"><Link>ReligionPersistence.cs</Link></Compile>
    <Compile Include="..\ReligionSimulationMath.cs"><Link>ReligionSimulationMath.cs</Link></Compile>
    <Compile Include="..\CharacterReligionMath.cs"><Link>CharacterReligionMath.cs</Link></Compile>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
